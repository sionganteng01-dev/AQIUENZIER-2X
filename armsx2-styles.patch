+/** Layout yang berdiri sendiri: Carousel dan Ps4 mengisi satu baris penuh; Glass dan Wall memakai kisi. */
+val LibraryLayout.isFullSpan: Boolean
+    get() = this == LibraryLayout.Carousel || this == LibraryLayout.Ps4
+
+/** Semua layout baru memakai latar hitam-putih beranimasi dan gaya kaca. */
+val LibraryLayout.isNew: Boolean
+    get() = this == LibraryLayout.Glass || this == LibraryLayout.Wall ||
+        this == LibraryLayout.Carousel || this == LibraryLayout.Ps4
