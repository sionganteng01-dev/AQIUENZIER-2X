+/** Geser (cover flow): kartu di tengah membesar, sisi lain mengecil dan memudar. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun CarouselLayout(
+    games: List<GameInfo>,
+    selectedIndex: Int,
+    onSelect: (Int) -> Unit,
+    onLaunch: (GameInfo) -> Unit,
+    onDetails: (GameInfo) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    if (games.isEmpty()) return
+    val sel = selectedIndex.coerceIn(0, games.lastIndex)
+    val scope = rememberCoroutineScope()
+    val pagerState = rememberPagerState(initialPage = sel, pageCount = { games.size })
+    LaunchedEffect(sel, games.size) {
+        if (pagerState.currentPage != sel) pagerState.animateScrollToPage(sel)
+    }
+    LaunchedEffect(pagerState.settledPage) {
+        if (pagerState.settledPage != sel) onSelect(pagerState.settledPage)
+    }
+    val game = games[pagerState.currentPage.coerceIn(0, games.lastIndex)]
+    Column(modifier.fillMaxWidth()) {
+        BoxWithConstraints(Modifier.fillMaxWidth()) {
+            val cardW = minOf(maxWidth * 0.52f, 260.dp)
+            val cardH = cardW * 1.45f
+            HorizontalPager(
+                state = pagerState,
+                modifier = Modifier.fillMaxWidth().height(cardH + 28.dp),
+                contentPadding = PaddingValues(horizontal = (maxWidth - cardW) / 2),
+                pageSize = PageSize.Fixed(cardW),
+                pageSpacing = 12.dp,
+                beyondViewportPageCount = 2,
+            ) { page ->
+                val g = games[page]
+                Box(
+                    Modifier
+                        .fillMaxSize()
+                        .graphicsLayer {
+                            val d = pagerState.getOffsetDistanceInPages(page).coerceIn(-1f, 1f)
+                            val focus = 1f - abs(d)
+                            val s = 0.8f + 0.2f * focus
+                            scaleX = s
+                            scaleY = s
+                            alpha = 0.4f + 0.6f * focus
+                            rotationY = -d * 14f
+                            cameraDistance = 12f * density
+                        }
+                        .combinedClickable(
+                            onClick = {
+                                if (page == pagerState.currentPage) onLaunch(g)
+                                else scope.launch { pagerState.animateScrollToPage(page) }
+                            },
+                            onLongClick = { onDetails(g) },
+                        ),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Box(Modifier.fillMaxWidth().glass(24.dp, selected = page == pagerState.currentPage).padding(10.dp)) {
+                        GameCover(
+                            g,
+                            Modifier.fillMaxWidth().aspectRatio(0.72f),
+                            cornerRadius = 18.dp,
+                            contentScale = ContentScale.Fit,
+                        )
+                    }
+                }
+            }
+        }
+        Spacer(Modifier.height(6.dp))
+        Text(
+            game.displayTitle(EnglishTitles.enabled.value),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.SemiBold,
+            color = Color.White,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 24.dp),
+            textAlign = TextAlign.Center,
+        )
+        Spacer(Modifier.height(12.dp))
+        Row(
+            Modifier.fillMaxWidth().padding(horizontal = 24.dp),
+            horizontalArrangement = Arrangement.spacedBy(12.dp, Alignment.CenterHorizontally),
+        ) {
+            GlassButton("Main", { onLaunch(game) }, primary = true)
+            GlassButton("Detail", { onDetails(game) })
+        }
+    }
+}
+
+/** PS4: latar besar dari game yang dipilih, lalu baris ubin kaca di bawahnya. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun Ps4Layout(
+    games: List<GameInfo>,
+    selectedIndex: Int,
+    onSelect: (Int) -> Unit,
+    onLaunch: (GameInfo) -> Unit,
+    onDetails: (GameInfo) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    if (games.isEmpty()) return
+    val sel = selectedIndex.coerceIn(0, games.lastIndex)
+    val game = games[sel]
+    val listState = rememberLazyListState()
+    LaunchedEffect(sel) { listState.animateScrollToItem(sel) }
+    Column(modifier.fillMaxWidth()) {
+        Box(Modifier.fillMaxWidth().height(320.dp)) {
+            Crossfade(targetState = sel, animationSpec = tween(450), label = "ps4-hero") { idx ->
+                GameCover(
+                    games[idx],
+                    Modifier.fillMaxSize().graphicsLayer { alpha = 0.55f },
+                    cornerRadius = 0.dp,
+                    contentScale = ContentScale.Crop,
+                    placeholderText = false,
+                )
+            }
+            Box(
+                Modifier.fillMaxSize().background(
+                    Brush.verticalGradient(
+                        listOf(Color.Transparent, Color.Black.copy(alpha = 0.6f), Color.Black),
+                    ),
+                ),
+            )
+            Column(Modifier.align(Alignment.BottomStart).padding(start = 20.dp, end = 20.dp, bottom = 16.dp)) {
+                Text(
+                    game.displayTitle(EnglishTitles.enabled.value),
+                    style = MaterialTheme.typography.headlineSmall,
+                    fontWeight = FontWeight.Bold,
+                    color = Color.White,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                Text(
+                    "Game ${sel + 1} dari ${games.size}",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = Color.White.copy(alpha = 0.7f),
+                )
+                Spacer(Modifier.height(12.dp))
+                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    GlassButton("Main", { onLaunch(game) }, primary = true)
+                    GlassButton("Detail", { onDetails(game) })
+                }
+            }
+        }
+        LazyRow(
+            state = listState,
+            contentPadding = PaddingValues(horizontal = 14.dp),
+            horizontalArrangement = Arrangement.spacedBy(12.dp),
+            modifier = Modifier.fillMaxWidth().padding(top = 8.dp, bottom = 12.dp),
+        ) {
+            itemsIndexed(games, key = { _, g -> g.uri.toString() }) { i, g ->
+                val focused = i == sel
+                val s by animateFloatAsState(if (focused) 1f else 0.86f, label = "ps4-tile")
+                Box(
+                    Modifier
+                        .width(118.dp)
+                        .graphicsLayer { scaleX = s; scaleY = s }
+                        .combinedClickable(
+                            onClick = { if (focused) onLaunch(g) else onSelect(i) },
+                            onLongClick = { onDetails(g) },
+                        )
+                        .glass(16.dp, selected = focused)
+                        .padding(6.dp),
+                ) {
+                    GameCover(g, Modifier.fillMaxWidth().aspectRatio(0.72f), cornerRadius = 12.dp)
+                }
+            }
+        }
+    }
+}
+
+/** Kisi kaca: kartu dengan bingkai kaca dan judul. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun GlassGridCard(game: GameInfo, selected: Boolean, onSelect: () -> Unit, onLaunch: () -> Unit, onDetails: () -> Unit) {
+    Column(
+        Modifier
+            .fillMaxWidth()
+            .glass(18.dp, selected = selected)
+            .combinedClickable(onClick = { onSelect(); onLaunch() }, onLongClick = onDetails)
+            .padding(8.dp),
+    ) {
+        GameCover(game, Modifier.fillMaxWidth().aspectRatio(0.72f), cornerRadius = 12.dp)
+        Spacer(Modifier.height(6.dp))
+        Text(
+            game.displayTitle(EnglishTitles.enabled.value),
+            style = MaterialTheme.typography.labelMedium,
+            color = Color.White.copy(alpha = if (selected) 1f else 0.8f),
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.padding(horizontal = 2.dp),
+        )
+    }
+}
+
+/** Dinding poster: hanya sampul, rapat, tanpa teks. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+fun PosterCard(game: GameInfo, selected: Boolean, onSelect: () -> Unit, onLaunch: () -> Unit, onDetails: () -> Unit) {
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .aspectRatio(0.72f)
+            .combinedClickable(onClick = { onSelect(); onLaunch() }, onLongClick = onDetails),
+    ) {
+        GameCover(game, Modifier.fillMaxSize(), cornerRadius = 6.dp)
+        if (selected) {
+            Box(Modifier.fillMaxSize().border(2.dp, Color.White, RoundedCornerShape(6.dp)))
+        }
+    }
+}
